# Fixed, platform-controlled Dockerfile for every Node.js site. `npm ci` is
# always run by this file, never by anything the AI wrote (validate.js also
# rejects any pre/postinstall script and any non-registry dependency source
# before this ever runs).
FROM node:22-alpine
# No extra OS packages needed: generated sites must use Node's built-in
# `node:sqlite` module (bundles its own SQLite, nothing to apk-install).

WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev --no-audit --no-fund; \
    else npm install --omit=dev --no-audit --no-fund --package-lock-only && npm ci --omit=dev --no-audit --no-fund; fi

COPY . .
RUN mkdir -p /data && chown -R node:node /data /app

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
USER node
CMD ["node", "server.js"]
