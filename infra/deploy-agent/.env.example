# Copy to .env (or set these as systemd Environment= lines — see
# infra/vps-setup.sh, which does this for you) and fill in real values.
# DEPLOY_AGENT_SECRET is a secret: never commit the real value.

# Long random string (>=32 chars). Must match the value Supabase's
# deploy-vps edge function sends as "Authorization: Bearer <this>".
# Generate one with: openssl rand -hex 32
DEPLOY_AGENT_SECRET=

# Port the agent listens on, loopback-only (Caddy is the only thing that
# should ever reach it; it is never exposed to the internet).
AGENT_PORT=8099

# Caddy's local admin API (loopback-only by default).
CADDY_ADMIN_URL=http://127.0.0.1:2019

# The wildcard domain customer sites are served under, e.g. a site with
# slug "my-store" becomes https://my-store.apps.ibtkar.ly
# You need a wildcard DNS record: *.apps.ibtkar.ly -> this VPS's IP.
APPS_DOMAIN=apps.ibtkar.ly

# Where each site's build context is written (ephemeral, auto-cleaned).
SITES_ROOT=/srv/sites
