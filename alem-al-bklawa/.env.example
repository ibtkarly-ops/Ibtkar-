# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Public URL of the store (used for canonical links, sitemap, Open Graph, payment return URLs)
SITE_URL=https://example.com
# Where the SQLite database and uploaded images live (mount a volume here)
DATA_DIR=./data
# Set to 1 when running behind a reverse proxy (Caddy/Nginx/Cloudflare) so the real client IP is used
TRUST_PROXY=1

# ── First admin (created on first start only if no admin exists yet) ──
# Use a long, unique password and change it from the admin panel afterwards.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Online payments (leave empty until you have a merchant account) ──
# Name of a provider module in server/payments/providers (see docs/PAYMENTS.md)
PAYMENT_PROVIDER=
# Secret used to verify webhooks from the provider (never exposed to the browser)
PAYMENT_WEBHOOK_SECRET=
# Never enable in production. Local test gateway that mimics success / failure / cancel.
PAYMENT_SANDBOX=0
