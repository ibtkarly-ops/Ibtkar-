# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Public URL of the store (canonical links, sitemap, Open Graph, payment return/webhook URLs). MUST be https in production.
SITE_URL=https://example.com
# Database + uploaded images + encryption key live here (mount a volume)
DATA_DIR=./data
# 1 when behind a reverse proxy (Caddy/Nginx/Cloudflare) so the real client IP is used
TRUST_PROXY=1
# Encrypts payment-gateway keys stored in the database (32+ random characters). Back it up with the database.
# If empty, a random key file is created in DATA_DIR/.secret
APP_SECRET=

# ── First admin (created on first start only if no admin exists) ──
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Payment gateways are configured from the admin panel (Admin → بوابات الدفع) — nothing to set here ──
# Development only (ignored in production): enables the fake "sandbox" gateway type
PAYMENT_SANDBOX=0
